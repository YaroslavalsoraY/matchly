# Скопируйте в .env и измените нужные значения. Файл .env читают docker compose и скрипты start.sh / start.cmd.
MATCHLY_PORT=8080
MATCHLY_DB_HOST=localhost
MATCHLY_DB_PORT=5432
MATCHLY_DB_NAME=matchly_db
MATCHLY_DB_USER=matchly
MATCHLY_DB_PASSWORD=matchly
MATCHLY_JWT_SECRET=matchly-dev-secret-key-change-me-please-0123456789
MATCHLY_JWT_TTL=12h
MATCHLY_ADMIN_EMAIL=admin@matchly.local
MATCHLY_ADMIN_PASSWORD=admin123
MATCHLY_SEED=true
